# OpenRouter API Configuration
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Next.js Environment
NODE_ENV=development

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://www.midtownvegascondos.com
NEXT_PUBLIC_AGENT_IMAGE_URL=https://pub-720ca9b7443b47be981def05abd3d7f0.r2.dev/shared/agent/dr-jan-duffy-headshot.jpg

# Cloudflare R2 image delivery (git copies in /public/images are the backup)
# After `node scripts/sync-images-to-r2.mjs`, set this to true so next/image loads from R2.
NEXT_PUBLIC_R2_ENABLED=false
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://pub-720ca9b7443b47be981def05abd3d7f0.r2.dev
NEXT_PUBLIC_R2_PREFIX=midtownvegascondos
# Optional Cloudflare Images (paid) — leave off unless account hash is configured
NEXT_PUBLIC_CLOUDFLARE_IMAGES_ENABLED=false
NEXT_PUBLIC_CLOUDFLARE_ACCOUNT_HASH=
# Optional Cloudflare Pages/Workers image host after R2/Images 401
NEXT_PUBLIC_CF_PAGES_IMAGES_ENABLED=false
NEXT_PUBLIC_CF_PAGES_IMAGES_BASE=https://midtownvegascondos-heading-photos.pages.dev
# Optional Cloudflare CDN hostname (proxied img.* → www origin). Leave false until HTTP 200.
NEXT_PUBLIC_CF_EDGE_IMAGES_ENABLED=false

# Google Search Console — HTML tag verification content (not the full meta tag)
# GSC → Settings → Ownership verification → HTML tag → paste the content= value only
GOOGLE_SITE_VERIFICATION=

# Google OAuth 2.0 Web Client ID (Cloud Console → APIs & Services → Credentials)
# Authorized JavaScript origins should include https://www.midtownvegascondos.com
# Maps / reviews always use the GBP office: 921 South Main Street, Las Vegas, NV 89101
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=584887863848-6iaq27hfjgoi7b32huhhmtjs46u36f4o.apps.googleusercontent.com

# Optional — Bing Webmaster Tools meta tag content
BING_SITE_VERIFICATION=
